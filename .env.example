# Cloudflare Worker secret used for admin-only catalog writes.
# Set this locally in .dev.vars and in production with:
# wrangler secret put ADMIN_PASSWORD
ADMIN_PASSWORD="change-me"

# Optional helper for local CLI usage.
APP_URL="http://127.0.0.1:8787"

# Bachs payment secret for the Buy button (/api/checkout).
# Leave unset to disable checkout; the endpoint then returns 503.
# Set this locally in .dev.vars and in production with:
# wrangler secret put BACHS_API_KEY
# Sandbox keys start with sk_sandbox_ and use sandbox-api.bachs.io.
BACHS_API_KEY="sk_sandbox_change-me"
